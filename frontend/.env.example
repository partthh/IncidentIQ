# Where the Spring Boot backend runs. Used only by vite.config.ts to build the
# dev-server proxy; the browser always talks to its own origin.
SENTINEL_API_URL=http://localhost:8080

# Production only. Set in the static host's *build* environment (Vite bakes it in at
# build time), never locally: the origin the STOMP handshake should go to when the
# host cannot proxy an upgrade — Vercel's rewrites forward HTTP but not `Upgrade`,
# so /ws would otherwise be answered with index.html. Leave unset in dev and Docker,
# where the same-origin proxy already reaches the backend. Either scheme works.
# VITE_WS_URL=https://incidentiq-9zhg.onrender.com